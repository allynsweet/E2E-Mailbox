{
  "name": "e2e-mailbox",
  "version": "1.2.0",
  "description": "E2E test your email notification system using temporary mailbox APIs.",
  "main": "dist/lib/index.js",
  "module": "dist/esm/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/esm/index.mjs",
      "require": "./dist/lib/index.js",
      "default": "./dist/lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/lib/index.d.ts",
  "author": "Allyn Sweet",
  "license": "MIT",
  "keywords": [
    "e2e",
    "email",
    "testing",
    "guerrillamail",
    "integration"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/allynsweet/E2E-Mailbox.git"
  },
  "scripts": {
    "build": "tsc && tsc --project tsconfig.esm.json",
    "postbuild": "node scripts/fix-esm-extensions.mjs",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "tslint -p tsconfig.json",
    "test": "jest --config jestconfig.json",
    "prepare": "yarn build && yarn lint && yarn test"
  },
  "devDependencies": {
    "@types/jest": "^26.0.23",
    "@types/node": "^20.0.0",
    "jest": "^29.7.0",
    "prettier": "^2.3.1",
    "ts-jest": "^29.1.1",
    "tslint": "^6.1.3",
    "tslint-config-prettier": "^1.18.0",
    "typescript": "^4.3.4"
  },
  "dependencies": {
    "axios": "^1.7.4",
    "typescript-email-parser": "1.0.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  }
}
